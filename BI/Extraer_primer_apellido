CASE
					WHEN (length(trim(d."Preferred Name")) -length(replace(trim(d."Preferred Name"), ' ', '')))  >= 2 THEN 
						CASE
							 WHEN lower(REVERSE(substring_before(substring_after(REVERSE(trim(d."Preferred Name")), ' '), ' '))) 
IN ( 'de'  , 'del'  , 'da'  , 'do'  , 'dos'  , 'das'  , 'van'  , 'von'  , 'la'  , 'las'  , 'los'  , 'y'  ) 

THEN initcap(REVERSE(substring_before(REVERSE(trim(d."Preferred Name")), ' '))) 
							 ELSE initcap(REVERSE(substring_before(substring_after(REVERSE(trim(d."Preferred Name")), ' '), ' ')))
						 END
					 ELSE initcap(REVERSE(substring_before(REVERSE(trim(d."Preferred Name")), ' ')))
				 END AS "Last name"
