# Plantilla de variables de entorno. Cópiala como .env y llena tus valores.
# El archivo .env está en .gitignore: nunca se sube al repositorio.

# cliente_api.py
API_BASE_URL=https://api.ejemplo.com/v2
OAUTH_TOKEN_URL=https://auth.ejemplo.com/oauth/token
OAUTH_REFRESH_TOKEN=cambia-esto
OAUTH_CLIENT_ID=cambia-esto
OAUTH_CLIENT_SECRET=cambia-esto

# despacho_sftp.py (autenticación con llave, no con contraseña)
SFTP_HOST=sftp.ejemplo.com
SFTP_PORT=22
SFTP_USER=usuario
SFTP_KEY_PATH=~/.ssh/id_ed25519
SFTP_KNOWN_HOSTS=~/.ssh/known_hosts
SFTP_REMOTE_DIR=/entrada

# alerta_sin_datos.py
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
SMTP_USER=alertas@ejemplo.com
SMTP_PASSWORD=cambia-esto
ALERTA_PARA=equipo@ejemplo.com

# cifrar_resultados.py (genera una con: python cifrar_resultados.py --nueva-llave)
LLAVE_DATOS_B64=cambia-esto
